@model BonVoyage_TravelAgency.Models.BookingFlightViewModel

@{
    ViewData["Title"] = "Book Flight";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Book Your Flight</h2>

<form asp-action="ConfirmBooking" asp-controller="Charters" class="form-horizontal" method="post">
    <div class="form-group">
        <label for="airline">Airline:</label>
        <input type="text" id="airline" name="airline" value="@Model.Airline" readonly class="form-control" />
    </div>
    <div class="form-group">
        <label for="from">From:</label>
        <input type="text" id="from" name="from" value="@Model.From" readonly class="form-control" />
    </div>
    <div class="form-group">
        <label for="to">To:</label>
        <input type="text" id="to" name="to" value="@Model.To" readonly class="form-control" />
    </div>
    <div class="form-group">
        <label for="departure">Departure:</label>
        <input type="text" id="departure" name="departure" value="@Model.Departure.ToString("g")" readonly class="form-control" />
    </div>
    <div class="form-group">
        <label for="arrival">Arrival:</label>
        <input type="text" id="arrival" name="arrival" value="@Model.Arrival.ToString("g")" readonly class="form-control" />
    </div>
    <div class="form-group">
        <label for="price">Price:</label>
        <input type="text" id="price" name="price" value="@Model.Price.ToString("C")" readonly class="form-control" />
    </div>
    <div class="form-group">
        <label for="passengerName">Passenger Name:</label>
        <input type="text" id="passengerName" name="passengerName" value="@Model.PassengerName" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="@Model.Email" class="form-control" readonly />
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Confirm Booking</button>
    </div>
</form>
