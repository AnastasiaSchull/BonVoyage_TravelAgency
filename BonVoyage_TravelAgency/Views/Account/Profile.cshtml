@model BonVoyage_TravelAgency.Models.UserProfileViewModel


@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="text-align: center !important;">@Model.User.UserName's Profile</h2>

<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (ViewData.ModelState["PasswordError"] != null)
{
    <div class="alert alert-danger">
        @ViewData.ModelState["PasswordError"].Errors[0].ErrorMessage
    </div>
}

@if (ViewData.ModelState["FieldError"] != null)
{
    <div class="alert alert-danger">
        @ViewData.ModelState["FieldError"].Errors[0].ErrorMessage
    </div>
}

<form asp-action="Profile" method="post" class="form-horizontal">
    <input type="hidden" asp-for="User.UserId" />
    <div class="form-group">
        <label asp-for="User.UserName" class="control-label col-md-2">Name</label>
        <div class="col-md-10">
            <input asp-for="User.UserName" class="form-control" />
            <span asp-validation-for="User.UserName" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="User.UserSurname" class="control-label col-md-2">Surname</label>
        <div class="col-md-10">
            <input asp-for="User.UserSurname" class="form-control" />
            <span asp-validation-for="User.UserSurname" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="User.Email" class="control-label col-md-2">Email</label>
        <div class="col-md-10">
            <input asp-for="User.Email" class="form-control" readonly />
            <span asp-validation-for="User.Email" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="User.Address" class="control-label col-md-2">Address</label>
        <div class="col-md-10">
            <input asp-for="User.Address" class="form-control" />
            <span asp-validation-for="User.Address" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="User.Country" class="control-label col-md-2">Country</label>
        <div class="col-md-10">
            <input asp-for="User.Country" class="form-control" />
            <span asp-validation-for="User.Country" class="text-danger"></span>
        </div>
    </div>
    <hr />
    <h3>Change Password</h3>
    <div class="form-group">
        <label for="oldPassword" class="control-label col-md-2">Old Password</label>
        <div class="col-md-10">
            <input type="password" name="oldPassword" class="form-control" />
        </div>
    </div>
    <div class="form-group">
        <label for="newPassword" class="control-label col-md-2">New Password</label>
        <div class="col-md-10">
            <input type="password" name="newPassword" class="form-control" />
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-primary">Update Profile</button>
        </div>
    </div>
</form>

<hr />


<div class="table-container text-center">
    <h2>Your Bookings</h2>
    <table class="table">
        <thead>
            <tr>
                <th>User</th>
                <th>User email</th>
                <th>Tour</th>
                <th>Booking date</th>
                <th>Number of people</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Bookings != null)
            {
                @foreach (var item in Model.Bookings)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.User)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.UserMail)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Tour)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BookingDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.NumberOfPeople)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Status)
                        </td>
                      
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
